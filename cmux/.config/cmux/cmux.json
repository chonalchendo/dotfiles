{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "automation": {
    "claudeCodeIntegration": true,
    "suppressSubagentNotifications": true
  },

  "shortcuts": {
    "bindings": {
      "splitRight": "ctrl+/",
      "splitDown": "ctrl+-",
      "focusLeft": "ctrl+h",
      "focusRight": "ctrl+l",
      "focusDown": "ctrl+j",
      "focusUp": "ctrl+k"
    }
  },

  "notifications": {
    "dockBadge": true,
    "showInMenuBar": true,
    "unreadPaneRing": true,
    "paneFlash": true,
    "sound": "Glass"
  },

  "terminal": {
    "autoResumeAgentSessions": true,
    "agentHibernation": {
      "enabled": false
    }
  }
}
